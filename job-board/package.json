{
  "name": "job-board",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^16.18.126",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "leaflet": "^1.9.4",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "zod": "^4.4.3"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "dev-server": "node scripts/dev-server.js",
    "fetch-occupations": "node scripts/fetch-occupation-lists.js",
    "build": "REACT_APP_BUILD_DATE=$(date +%Y-%m-%d) react-scripts build",
    "postbuild": "node scripts/sync-data.js build",
    "build:pages": "REACT_APP_BUILD_DATE=$(date +%Y-%m-%d) BUILD_PATH=../docs react-scripts build && touch ../docs/.nojekyll",
    "postbuild:pages": "node scripts/sync-data.js ../docs",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "proxy": "http://localhost:4000",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "react/jsx-no-target-blank": [
        "warn",
        {
          "allowReferrer": true
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
